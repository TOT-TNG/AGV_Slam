# Đặt tại: /etc/systemd/system/agv-gateway.service
[Unit]
Description=AGV Cloud API Gateway
After=network.target frps.service

[Service]
WorkingDirectory=/etc/agv-gateway
ExecStart=/etc/agv-gateway/venv/bin/uvicorn gateway:app --host 127.0.0.1 --port 9000 --workers 2
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
